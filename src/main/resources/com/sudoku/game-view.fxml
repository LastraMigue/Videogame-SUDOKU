<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sudoku.controller.GameController"
            styleClass="main-container" stylesheets="@../../styles/sudoku.css"
            prefWidth="500.0" prefHeight="600.0">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 0 0 20 0;">
            <Button text="← VOLVER" onAction="#handleBackToMenu" styleClass="btn-secondary" />
            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label fx:id="difficultyLabel" text="DIFICULTAD: -" style="-fx-text-fill: #bac2de; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Label fx:id="helpStatusLabel" text="AYUDA: DESACTIVADA" style="-fx-text-fill: #f38ba8; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="timerLabel" text="00:00" style="-fx-text-fill: #89b4fa; -fx-font-size: 20px; -fx-font-weight: bold;" />
        </HBox>
    </top>
    
    <center>
        <StackPane fx:id="boardContainer" alignment="CENTER">
            <!-- El tablero se generará dinámicamente en BoardView -->
        </StackPane>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20 0 0 0;">
            <Button text="PISTA" onAction="#handleHint" styleClass="btn-secondary" />
            <Button text="AYUDA" onAction="#handleToggleHelp" styleClass="btn-secondary" />
            <Button text="SOLUCIONAR" onAction="#handleSolve" styleClass="btn-secondary" />
            <Button text="REINICIAR" onAction="#handleReset" styleClass="btn-primary" />
        </HBox>
    </bottom>
</BorderPane>
