<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="30.0" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sudoku.controller.MenuController"
      styleClass="main-container" stylesheets="@../../styles/sudoku.css">
    
    <Label text="SUDOKU" styleClass="title" />
    
    <VBox spacing="15.0" alignment="CENTER">
        <Button text="MODO FÁCIL" onAction="#handleEasyMode" styleClass="btn-primary, difficulty-btn" />
        <Button text="MODO MEDIO" onAction="#handleMediumMode" styleClass="btn-secondary, difficulty-btn" />
        <Button text="MODO DIFÍCIL" onAction="#handleHardMode" styleClass="btn-secondary, difficulty-btn" />
    </VBox>
    
    <Label text="Selecciona una dificultad para comenzar" style="-fx-text-fill: #6c7086;" />
</VBox>
